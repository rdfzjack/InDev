extends SceneTree
## Dialogue line-ID stamper + translation table exporter.
##
## godot --headless --path . --script res://tools/dlg_tool.gd
##
## 1. 给 data/dialogue/*.dlg 里缺 ID 的台词和选项盖上 " #<文件>.<节点>.<序号>"。已有 ID 不动。
## 2. 导出 data/text/dialogue.tsv：key / zh_CN / en / speaker / file。
##    zh_CN 每次从 .dlg 重新生成；其他语言列保留已有的翻译。

const DLG_DIR := "res://data/dialogue"
const OUT := "res://data/text/dialogue.tsv"
const LOCALES := ["zh_CN", "en"]


func _init() -> void:
	var old := _read_existing()
	var rows: Array = []
	var files := Array(DirAccess.get_files_at(DLG_DIR)).filter(func(f): return f.ends_with(".dlg"))
	files.sort()
	for f in files:
		rows.append_array(_stamp(DLG_DIR + "/" + f, f.get_basename(), old))
	_write(rows)
	print("dlg_tool: %d lines across %d files -> %s" % [rows.size(), files.size(), OUT])
	quit()


func _classify(s: String) -> String:
	if s == "" or s.begins_with("#") or s.begins_with("~") or s.begins_with("@") or s.begins_with("$") or s.begins_with("->"):
		return ""
	if s.begins_with("-"):
		return "opt"
	if s.find(":") > 0 or s.find(DialogueScript.FULLWIDTH_COLON) > 0:
		return "line"
	return ""


func _stamp(path: String, file_key: String, old: Dictionary) -> Array:
	var src := FileAccess.get_file_as_string(path)
	var lines := src.split("\n")
	var node := ""
	var counters := {}
	# first pass: find max existing index per node
	for raw in lines:
		var s := raw.strip_edges()
		if s.begins_with("~"):
			node = s.substr(1).strip_edges()
			continue
		var id: String = DialogueScript.split_id(s)[1]
		if id != "":
			var n := int(id.get_slice(".", id.get_slice_count(".") - 1))
			counters[node] = maxi(int(counters.get(node, 0)), n)
	# second pass: stamp + collect
	var out_rows: Array = []
	node = ""
	var changed := false
	for i in lines.size():
		var raw: String = lines[i]
		var s := raw.strip_edges()
		if s.begins_with("~"):
			node = s.substr(1).strip_edges()
			continue
		var kind := _classify(s)
		if kind == "":
			continue
		var sp := DialogueScript.split_id(s)
		var id: String = sp[1]
		if id == "":
			counters[node] = int(counters.get(node, 0)) + 1
			id = "%s.%s.%02d" % [file_key, node, counters[node]]
			lines[i] = raw.rstrip(" \t") + "  #" + id
			changed = true
		var body: String = sp[0]
		var speaker := ""
		if kind == "opt":
			body = body.substr(1).strip_edges()
			if body.begins_with("["):
				body = body.substr(body.find("]") + 1).strip_edges()
			var arrow := body.rfind("->")
			if arrow >= 0:
				body = body.substr(0, arrow).strip_edges()
			speaker = "(option)"
		else:
			var c := body.find(":")
			var cf := body.find(DialogueScript.FULLWIDTH_COLON)
			if c < 0 or (cf >= 0 and cf < c):
				c = cf
			speaker = body.substr(0, c).strip_edges()
			body = body.substr(c + 1).strip_edges()
		var row := {"key": id, "zh_CN": body, "speaker": speaker, "file": file_key}
		for loc in LOCALES:
			if loc != "zh_CN":
				row[loc] = old.get(id, {}).get(loc, "")
		out_rows.append(row)
	if changed:
		var f := FileAccess.open(path, FileAccess.WRITE)
		f.store_string("\n".join(lines))
		print("dlg_tool: stamped ", path)
	return out_rows


func _read_existing() -> Dictionary:
	var res := {}
	if not FileAccess.file_exists(OUT):
		return res
	var f := FileAccess.open(OUT, FileAccess.READ)
	var header: PackedStringArray = []
	while not f.eof_reached():
		var raw := f.get_line()
		if raw.strip_edges() == "" or raw.begins_with("#"):
			continue
		var cells := raw.split("\t")
		if header.is_empty():
			header = cells
			continue
		var r := {}
		for i in header.size():
			r[header[i]] = cells[i] if i < cells.size() else ""
		res[r.get("key", "")] = r
	return res


func _write(rows: Array) -> void:
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_line("# GENERATED by tools/dlg_tool.gd. zh_CN is regenerated from .dlg files; other locale columns are preserved.")
	var cols := ["key"] + LOCALES + ["speaker", "file"]
	f.store_line("\t".join(cols))
	for r in rows:
		var cells := []
		for c in cols:
			cells.append(String(r.get(c, "")).replace("\t", " "))
		f.store_line("\t".join(cells))
